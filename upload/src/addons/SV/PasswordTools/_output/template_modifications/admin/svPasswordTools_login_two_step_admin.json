{
    "template": "login_two_step",
    "description": "Support custom expiry times",
    "execution_order": 10,
    "enabled": true,
    "action": "preg_replace",
    "find": "#phrase\\('(trust_this_device_for_30_days|trust_device_desc)'\\)#si",
    "replace": "$xf.options.sv2faExpiryTime > 0 ? phrase('svPasswordTools_$1_x', {'days': $xf.options.sv2faExpiryTime }) : phrase('$1')"
}